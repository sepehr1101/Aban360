<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <!-- Build the API first; use its exact dependency set for the isolated net10 Roslyn runner. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="../../Aban360.Api/bin/$(Configuration)/net8.0/*.dll" Exclude="../../Aban360.Api/bin/$(Configuration)/net8.0/Microsoft.VisualStudio.TestPlatform.MSTestAdapter.PlatformServices.dll" />
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
